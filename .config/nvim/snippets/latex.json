{
  "Equation Aligned": {
    "prefix": "eqali",
    "body": [
      "\\\\begin{equation*}",
      "\t\\\\begin{aligned}",
      "\t\t$0",
      "\t\\\\end{aligned}",
      "\\\\end{equation*}"
    ],
    "description": "Equation* and aligned environments"
  },
  "text txpewriter": {
    "prefix": "tt",
    "body": [
      "\\\\texttt{$0}"
    ],
    "description": "text typewriter"
  }
}
